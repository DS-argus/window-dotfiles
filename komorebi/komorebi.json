    "palette": "Catppuccin",
    "name": "Mocha",
    "single_border": "Blue",
    "stack_border": "Green",
    "monocle_border": "Mauve",
    "floating_border": "Yellow",
    "unfocused_border": "Surface0",
    "unfocused_locked_border": "Red",
    "bar_accent": "Lavender"
  },
